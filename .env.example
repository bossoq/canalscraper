# Required. Discord channel -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Comma-separated; one value is fine. 162 = a Bangkok water-level station.
STATION_IDS=162

# Chart only the last N hours. Leave empty to chart every reading on the page.
HOURS=24

# Seconds between rounds. 3600 = hourly.
INTERVAL_SECONDS=3600

# Post to Discord on 1 round in N. 1 = every round. Raise this to quiet the
# channel; the scrape and Home Assistant keep running every round.
DISCORD_EVERY=1

TZ=Asia/Bangkok

# --- Home Assistant (both halves optional, both skipped when left unset) ---

# Live sensor over MQTT. The broker has to be reachable from the container, so
# an HA add-on broker is its host's address, not "localhost".
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC_PREFIX=canalscraper

# The last 48h as hourly statistics, over HA's WebSocket API. HA_TOKEN is a
# long-lived access token: profile -> Security -> Long-lived access tokens.
HA_URL=
HA_TOKEN=
